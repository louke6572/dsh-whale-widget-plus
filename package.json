{
  "name": "dsh-dfy",
  "version": "0.7.5",
  "displayName": "dsh-Dfy",
  "description": "QQ × B站 × 桌宠一体化插件：统一设置窗口、小鲸鱼余额挂件、106 段透明动画桌宠、QQ 消息卡与双向脱敏记忆。",
  "type": "module",
  "engines": {
    "node": ">=22.13.0",
    "dsh": ">=0.2.1-rc.2"
  },
  "icon": "./icon.png",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./qq-tool-restrict.mjs": "./backend/qq-tool-restrict.mjs",
    "./icon": "./icon.png",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "setup": "node scripts/setup-dsh.mjs",
    "build": "node build.mjs",
    "presets": "node scripts/build-agent-preset-patches.mjs",
    "snowluma": "node scripts/install-snowluma.mjs",
    "audit": "node widget/tools/ci-audit.mjs --no-pack",
    "postinstall": "node scripts/patch-snowluma-sdk.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-host-apiproxy": "0.1.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.1",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@snowluma/mcp": "^1.14.20",
    "@snowluma/sdk": "^1.14.20",
    "douyin-im": "^1.1.0",
    "edge-tts": "^1.0.1",
    "js-yaml": "^4.3.2",
    "playwright-core": "^1.65.0",
    "ws": "^8.22.1",
    "zod": "^4.4.3"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./presets/qq-chat.patch.yml",
        "./presets/qq-chat-v2.patch.yml",
        "./presets/douyin-chat.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/louke6572/dsh-Dfy.git"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "dsh-bundle",
    "deepseek-harness",
    "deepseek",
    "desktop-pet",
    "qq-bot",
    "bilibili",
    "balance",
    "whale",
    "widget"
  ],
  "bugs": {
    "url": "https://github.com/louke6572/dsh-Dfy/issues"
  },
  "homepage": "https://github.com/louke6572/dsh-Dfy#readme",
  "files": [
    "lib",
    "backend",
    "widget",
    "src",
    "scripts",
    "presets",
    "shims",
    "locale",
    "public",
    "assets",
    "roles",
    "examples",
    "dsh",
    "icon.png",
    "cordis.patch.yml",
    "config.example.json",
    "README.md",
    "AGENT.md",
    "PROVENANCE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "license": "MIT"
}
